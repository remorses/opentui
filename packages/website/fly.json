{
  "app": "opentui",
  "primary_region": "iad",
  "regions": ["iad", "fra", "sjc"],
  "build": {
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "strategy": "bluegreen"
  },
  "http_service": {
    "internal_port": 3001,
    "force_https": true,
    "auto_stop_machines": "stop",
    "auto_start_machines": true,
    "min_machines_running": 0,
    "processes": ["app"]
  },
  "checks": {
    "health": {
      "type": "http",
      "port": 3001,
      "path": "/health",
      "interval": "10s",
      "timeout": "5s"
    }
  },
  "vm": [
    {
      "memory": "1GB",
      "cpu_kind": "shared",
      "cpus": 1
    }
  ]
}
