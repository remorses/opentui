{
  "name": "@opentuah/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.tsx",
    "build": "bun install --os=\"*\" --cpu=\"*\" bun-webgpu && bun build --compile --target=bun-linux-x64 src/server.tsx --outfile=dist/server-linux",
    "build:local": "bun build --compile src/server.tsx --outfile=dist/server",
    "dev:compiled": "bun run build:local && ./dist/server",
    "deployment": "bun run build && fly deploy --local-only"
  },
  "dependencies": {
    "@opentuah/web": "workspace:*",
    "@opentui/core": "workspace:*",
    "@opentui/react": "workspace:*",
    "bun-webgpu": "^0.1.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
